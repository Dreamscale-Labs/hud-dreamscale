# Use the same pinned CPU simulator, changing only its observation-profile entrypoint.
# Supply a digest-pinned image built from this revision's Dockerfile.hud.
ARG LIBERO_BASE_IMAGE
FROM ${LIBERO_BASE_IMAGE}
ENV HUD_OBSERVATION_PROFILE=libero-raw360-v1
CMD ["hud", "serve", "pooled_env.py", "--host", "0.0.0.0", "--port", "8765"]
