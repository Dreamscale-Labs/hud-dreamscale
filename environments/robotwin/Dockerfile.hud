# RoboTwin 2.0 sim image. Sapien renders with Vulkan on the NVIDIA GPU HUD attaches.
# ROBOTWIN_ROOT is the checkout LeRobot imports tasks from.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    ROBOTWIN_ROOT=/opt/RoboTwin \
    ASSETS_PATH=/opt/RoboTwin \
    NVIDIA_DRIVER_CAPABILITIES=all \
    VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json \
    __GLX_VENDOR_LIBRARY_NAME=nvidia

RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake build-essential unzip \
    libgl1 libglib2.0-0 libegl1 libxext6 libsm6 libxrender1 libgomp1 libvulkan1 \
    && mkdir -p /usr/share/vulkan/icd.d /usr/share/glvnd/egl_vendor.d \
    && printf '%s\n' \
        '{"file_format_version":"1.0.0","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.3.0"}}' \
        > /usr/share/vulkan/icd.d/nvidia_icd.json \
    && printf '%s\n' \
        '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}' \
        > /usr/share/glvnd/egl_vendor.d/10_nvidia.json \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml patch_wheels.py ./
# Pin the RoboTwin checkout LeRobot's joint-control wrapper was written against.
ARG ROBOTWIN_SHA=0aeea2d669c0f8516f4d5785f0aa33ba812c14b4
RUN pip install --no-cache-dir uv && uv sync --no-dev \
    && git init /opt/RoboTwin \
    && git -C /opt/RoboTwin remote add origin https://github.com/RoboTwin-Platform/RoboTwin.git \
    && git -C /opt/RoboTwin fetch --depth 1 origin ${ROBOTWIN_SHA} \
    && git -C /opt/RoboTwin checkout FETCH_HEAD \
    && rm -rf /opt/RoboTwin/.git \
    && uv run python -c "from huggingface_hub import hf_hub_download; \
[hf_hub_download('TianxingChen/RoboTwin2.0', name, repo_type='dataset', local_dir='/opt/RoboTwin/assets') \
for name in ('embodiments.zip', 'objects.zip')]" \
    && cd /opt/RoboTwin/assets && unzip -q -o embodiments.zip && unzip -q -o objects.zip \
    && rm -f embodiments.zip objects.zip \
    && cd /opt/RoboTwin && /app/.venv/bin/python script/update_embodiment_config_path.py \
    && ln -sfn curobo_left.yml /opt/RoboTwin/assets/embodiments/aloha-agilex/curobo.yml \
    && /app/.venv/bin/python /app/patch_wheels.py
COPY env.py sim.py contract.json ./

EXPOSE 8765
CMD ["uv", "run", "hud", "serve", "env.py", "--host", "0.0.0.0", "--port", "8765"]
